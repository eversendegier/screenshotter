{
  "name": "screenshotter",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build": "electron-builder --mac dmg",
    "setup": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "nl.eversendegier.screenshotter",
    "productName": "Screenshotter",
    "asar": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "icon.icns"
    },
    "files": [
      "main.js",
      "server.js",
      "index.html",
      "node_modules/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ]
  }
}
